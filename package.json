{
	"name": "n8n-nodes-bulktranscripts",
	"version": "0.1.0",
	"description": "n8n community node for BulkTranscripts: YouTube transcripts for a video, channel or playlist, YouTube search, and free new-upload tracking.",
	"license": "MIT",
	"homepage": "https://bulktranscripts.co/integrations/n8n-youtube-transcripts",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"youtube",
		"youtube-transcript",
		"transcript",
		"captions",
		"subtitles",
		"bulktranscripts"
	],
	"author": {
		"name": "BulkTranscripts",
		"email": "hello@bulktranscripts.co",
		"url": "https://bulktranscripts.co"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/pratie/n8n-nodes-bulktranscripts.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BulkTranscriptsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BulkTranscripts/BulkTranscripts.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
